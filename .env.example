# Gmail SMTP Email OTP Configuration
# Note: MAIL_PASSWORD must be a 16-character Google App Password (not your Gmail login password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Central Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resilientx
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security
JWT_SECRET=resilientx_super_secret_jwt_key_for_dr_control_plane_security_2026_enterprise

# Cloud Provider Integration (Deferred: Keep false for $0 cost)
AWS_ENABLED=false

